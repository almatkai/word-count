[package]
name = "word-count-beta-contracts"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
license = "Apache-2.0 AND MIT"
[lib]
test = false
doctest = false
[dependencies]
tezbar-word-count = { path = "../.." }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.150"
tokio = { version = "=1.52.3", features = ["rt-multi-thread", "sync", "time", "macros"] }
uuid = { version = "=1.23.3", features = ["v4"] }
log = "=0.4.32"
tempfile = "=3.27.0"

[[bin]]
name = "adapter-oracle"
path = "src/bin/oracle.rs"
