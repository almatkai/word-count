#[tokio::test]
async fn native_clear_cancels_pending_selection_without_os_or_lingering_session() {
    let f = Fixture::new(vec![]);
    f.install();
    let sessions = Sessions::default();
    let ctx = CoreContext::new(f.ctx.paths.clone(), None);
    let entered = Arc::new(tokio::sync::Notify::new());
    let notify = entered.clone();
    ctx.set_router(Arc::new(move |channel, args| {
        assert_eq!(channel, "core:platform:selected-text");
        assert!(args.is_empty());
        let notify = notify.clone();
        Box::pin(async move {
            notify.notify_one();
            std::future::pending::<CoreResult>().await
        })
    }))
    .unwrap();
    let s = sessions.clone();
    let c = ctx.clone();
    let pending = tokio::spawn(async move {
        s.call(
            &c,
            "extension:run-command",
            json!({"extensionId":"com.tezbar.native.word-count","commandName":"count"}),
        )
        .await
        .unwrap()
    });
    tokio::time::timeout(std::time::Duration::from_secs(2), entered.notified())
        .await
        .unwrap();
    sessions.clear().await;
    let result = tokio::time::timeout(std::time::Duration::from_secs(2), pending)
        .await
        .unwrap()
        .unwrap();
    assert_eq!(result["ok"], false);
    assert!(result.get("sessionId").is_none());
    f.done();
}
#[tokio::test]
async fn native_uninstall_invalidates_active_capabilities_and_alias_launch_is_compiled() {
    let f = Fixture::new(vec![selected("alias")]);
    f.install();
    let sessions = Sessions::default();
    let v = sessions
        .call(
            &f.ctx,
            "extension:run-command",
            json!({"extensionId":"raycast.word-count","commandName":"count"}),
        )
        .await
        .unwrap();
    assert_eq!(v["ok"], true);
    let id = v["sessionId"].clone();
    std::fs::remove_file(f.ctx.paths.data_dir.join("fixture-installation.json")).unwrap();
    let result = sessions
        .call(
            &f.ctx,
            "extension:invoke-action",
            json!({"sessionId":id,"actionId":v["actions"][1]["id"]}),
        )
        .await
        .unwrap();
    assert_eq!(result["ok"], false);
    let stale = sessions
        .call(&f.ctx, "extension:refresh-session", json!({"sessionId":id}))
        .await
        .unwrap();
    assert_eq!(stale["ok"], false);
    f.done();
}
